{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Playdate: Build",
        "type": "shell",
        "command": "pdc",
        "problemMatcher": ["$pdc-lua", "$pdc-external"],
        "args": [
          {
            "value": "${workspaceFolder}/source/main.lua",
            "quoting": "escape"
          },
          {
            "value": "${workspaceFolder}/builds/${workspaceFolderBasename}.pdx",
            "quoting": "escape"
          }
        ]
      },
      {
        "type": "playdate-simulator",
        "problemMatcher": ["$pdc-external"],
        "label": "Playdate: Run"
      },
      {
        "label": "Playdate: Build and Run",
        "dependsOn": ["Playdate: Build", "Playdate: Run"],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      }
    ]
  }
